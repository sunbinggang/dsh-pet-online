{
  "name": "dsh-pet-online",
  "version": "0.4.0",
  "description": "给 dsh-pet 桌宠加在线联机：多台机器配对后互相看见、互动、跨机聊天，远端宠物投影到本机浮层并带本地物理。不改 dsh-pet 源码，只走它公开的 /dsh-pet-7340 路由。",
  "type": "module",
  "main": "lib/index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./protocol": "./lib/protocol.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "relay",
    "scripts",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dsh-pet",
    "desktop-pet",
    "multiplayer",
    "online"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "relay": "node relay/server.mjs",
    "selfcheck": "node scripts/selfcheck.mjs",
    "livecheck": "node scripts/livecheck.mjs",
    "install:profile": "node scripts/install.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    },
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.1": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.1",
    "react": "^18.2.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunbinggang/dsh-pet-online.git"
  },
  "homepage": "https://github.com/sunbinggang/dsh-pet-online#readme",
  "bugs": {
    "url": "https://github.com/sunbinggang/dsh-pet-online/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
